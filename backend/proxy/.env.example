NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Upstream Service Tiers (Docker hostnames or localhost ports)
TIER_6_URL="http://localhost:4006"
TIER_5_URL="http://localhost:4005"
TIER_4_URL="http://localhost:4004"
TIER_3_URL="http://localhost:4003"
TIER_2_URL="http://localhost:4002"
TIER_1_URL="http://localhost:4001"

# Manual Tier Override (Leave blank or set 1-6 for benchmarks)
MANUAL_TIER_OVERRIDE=""

# Hysteresis & Cooldown Settings
COOLDOWN_PERIOD_MS=15000
SLIDING_WINDOW_SECONDS=10
